{
  "name": "@orchestra-design-system/react",
  "version": "0.1.0",
  "description": "React wrappers for Orchestra design system web components",
  "author": "Yann Isabel",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "lib",
    "dist"
  ],
  "scripts": {
    "build": "npm run patch:generated && npm run tsc",
    "tsc": "tsc -p . --outDir ./dist --noEmitOnError false",
    "patch:generated": "node scripts/patch-generated-files.cjs"
  },
  "dependencies": {
    "@orchestra-design-system/core": "^0.1.0",
    "@stencil/playwright": "^0.6.0",
    "@stencil/react-output-target": "^1.6.0",
    "@storybook/addon-coverage": "^0.0.4",
    "eslint": "^10.14.0",
    "jest-cli": "^25.1.0",
    "lerna": "^10.1.1",
    "release-it": "21.1.2",
    "style-dictionary": "^5.7.1",
    "typescript-eslint": "^7.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yannisabel/orchestra.git"
  },
  "peerDependencies": {
    "react": ">=17 <20",
    "react-dom": ">=17 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "design-system",
    "react",
    "web-components",
    "orchestra"
  ],
  "license": "MIT"
}
